generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  STAFF
}

enum ProductCategory {
  FUEL
  DEF
  LUBRICANTS
  FLUIDS
  RETAIL
  ACCESSORIES
  SERVICES
  EV_CHARGING
  OTHER
}

enum UnitOfMeasure {
  LITRE
  KILOGRAM
  PIECE
  BOX
  UNIT
  KWH
}

enum TankType {
  UNDERGROUND
  ABOVE_GROUND
}

enum DipMethod {
  MANUAL
  ATG
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  DRAFT
  OPEN
  CLOSING
  RECONCILIATION_REQUIRED
  RECONCILED
  LOCKED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  FLEET
  OTHER
}

enum SaleKind {
  METERED
  PRODUCT
  SERVICE
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
}

enum CustomerType {
  CREDIT
  FLEET
}

enum CustomerLedgerType {
  SALE
  RECEIPT
  ADJUSTMENT
}

enum PurchaseInvoiceStatus {
  OPEN
  PART_PAID
  PAID
  VOID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum OwnerNotificationType {
  DENSITY_MISSING
  LOW_STOCK
  SHIFT_VARIANCE
  SHIFT_OPEN
  APPROVAL_REQUIRED
  DAILY_SUMMARY
  OVERDUE_CUSTOMER
  SYSTEM_TEST
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OwnerAlertSeverity {
  INFORMATION
  ATTENTION
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  INVENTORY_ADJUSTMENT
}

model Organization {
  id                         String                      @id @default(cuid())
  name                       String
  setupFeePaidAt             DateTime?                   @map("setup_fee_paid_at")
  lifetimeAccessPaidAt       DateTime?                   @map("lifetime_access_paid_at")
  subscriptionUpdatedAt      DateTime?                   @map("subscription_updated_at")
  subscriptionUpdatedBy      String?                     @map("subscription_updated_by")
  intelligenceEnabledAt      DateTime?                   @map("intelligence_enabled_at")
  intelligenceExpiresAt      DateTime?                   @map("intelligence_expires_at")
  subscriptionPlan           String?                     @map("subscription_plan")
  subscriptionBillingPeriod  String?                     @map("subscription_billing_period")
  subscriptionPricePaise     Int?                        @map("subscription_price_paise")
  subscriptionActivatedAt    DateTime?                   @map("subscription_activated_at")
  subscriptionExpiresAt      DateTime?                   @map("subscription_expires_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  users                      User[]
  stations                   Station[]
  products                   Product[]
  productCategories          ProductCategorySetting[]
  taxCategories              TaxCategory[]
  sales                      Sale[]
  inventoryLedger            InventoryLedger[]
  purchaseReceipts           PurchaseReceipt[]
  tankReadings               TankReading[]
  densityReadings            TankDensityReading[]
  customers                  Customer[]
  customerReceipts           CustomerReceipt[]
  customerLedger             CustomerLedgerEntry[]
  suppliers                  Supplier[]
  purchaseInvoices           PurchaseInvoice[]
  supplierPayments           SupplierPayment[]
  expenseCategories          ExpenseCategory[]
  expenses                   Expense[]
  chartAccounts              ChartAccount[]
  journals                   Journal[]
  notificationSettings       OwnerNotificationSettings?
  notificationDeliveries     OwnerNotificationDelivery[]
  ownerAlerts                OwnerAlert[]
  pushDevices                OwnerPushDevice[]
  pushDeliveries             OwnerPushDelivery[]
  dailyBriefings             DailyOwnerBriefing[]
  intelligenceQuestions      IntelligenceQuestion[]
  intelligenceInvestigations IntelligenceInvestigation[]
  approvalRequests           ApprovalRequest[]
  stationSetupDrafts         StationSetupDraft[]
  receiptTimingEvents        ReceiptTimingAuditEvent[]

  @@map("organizations")
}

model Station {
  id                         String                      @id @default(cuid())
  organizationId             String                      @map("organization_id")
  name                       String
  code                       String
  addressLine1               String                      @map("address_line_1")
  city                       String
  state                      String
  postalCode                 String                      @map("postal_code")
  phone                      String?
  gstin                      String?
  openingTime                String?                     @map("opening_time")
  closingTime                String?                     @map("closing_time")
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  configurations             StationConfiguration[]
  shifts                     Shift[]
  sales                      Sale[]
  inventoryLedger            InventoryLedger[]
  purchaseReceipts           PurchaseReceipt[]
  tankReadings               TankReading[]
  densityReadings            TankDensityReading[]
  customerReceipts           CustomerReceipt[]
  customerLedger             CustomerLedgerEntry[]
  purchaseInvoices           PurchaseInvoice[]
  supplierPayments           SupplierPayment[]
  expenses                   Expense[]
  journals                   Journal[]
  userAccess                 UserStationAccess[]
  notificationDeliveries     OwnerNotificationDelivery[]
  ownerAlerts                OwnerAlert[]
  intelligenceQuestions      IntelligenceQuestion[]
  intelligenceInvestigations IntelligenceInvestigation[]
  approvalRequests           ApprovalRequest[]
  setupDraft                 StationSetupDraft?
  receiptTimingEvents        ReceiptTimingAuditEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("stations")
}

model StationSetupDraft {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  stationId      String       @unique @map("station_id")
  setup          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station        Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@map("station_setup_drafts")
}

model OwnerNotificationSettings {
  id                     String       @id @default(cuid())
  organizationId         String       @unique @map("organization_id")
  whatsappNumber         String?      @map("whatsapp_number")
  whatsappOptedIn        Boolean      @default(false) @map("whatsapp_opted_in")
  densityMissingEnabled  Boolean      @default(true) @map("density_missing_enabled")
  lowStockEnabled        Boolean      @default(true) @map("low_stock_enabled")
  shiftVarianceEnabled   Boolean      @default(true) @map("shift_variance_enabled")
  unclosedShiftEnabled   Boolean      @default(true) @map("unclosed_shift_enabled")
  dailySummaryEnabled    Boolean      @default(true) @map("daily_summary_enabled")
  overdueCustomerEnabled Boolean      @default(true) @map("overdue_customer_enabled")
  lowStockPercent        Int          @default(20) @map("low_stock_percent")
  varianceThreshold      Decimal      @default(500) @map("variance_threshold") @db.Decimal(12, 2)
  stockVarianceTolerance Decimal      @default(50) @map("stock_variance_tolerance") @db.Decimal(12, 3)
  dailySummaryHour       Int          @default(20) @map("daily_summary_hour")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("owner_notification_settings")
}

model OwnerNotificationDelivery {
  id                String                     @id @default(cuid())
  organizationId    String                     @map("organization_id")
  stationId         String?                    @map("station_id")
  type              OwnerNotificationType
  dedupeKey         String                     @unique @map("dedupe_key")
  destination       String                     @map("destination")
  message           String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @map("provider_message_id")
  errorMessage      String?                    @map("error_message")
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station           Station?                   @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([stationId, createdAt])
  @@map("owner_notification_deliveries")
}

model OwnerAlert {
  id                 String                @id @default(cuid())
  organizationId     String                @map("organization_id")
  stationId          String?               @map("station_id")
  type               OwnerNotificationType
  severity           OwnerAlertSeverity
  dedupeKey          String                @unique @map("dedupe_key")
  title              String
  message            String
  evidenceLabel      String                @map("evidence_label")
  evidencePath       String                @map("evidence_path")
  evidenceSourceType String?               @map("evidence_source_type")
  evidenceSourceId   String?               @map("evidence_source_id")
  packet             Json?
  readAt             DateTime?             @map("read_at")
  acknowledgedAt     DateTime?             @map("acknowledged_at")
  acknowledgedById   String?               @map("acknowledged_by_id")
  resolvedAt         DateTime?             @map("resolved_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station            Station?              @relation(fields: [stationId], references: [id], onDelete: Restrict)
  acknowledgedBy     User?                 @relation("alert_acknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  pushDeliveries     OwnerPushDelivery[]

  @@index([organizationId, createdAt])
  @@index([stationId, createdAt])
  @@index([organizationId, acknowledgedAt, createdAt])
  @@map("owner_alerts")
}

model OwnerPushDevice {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  userId         String              @map("user_id")
  token          String              @unique
  platform       String              @default("IOS")
  environment    String              @default("PRODUCTION")
  active         Boolean             @default(true)
  lastSeenAt     DateTime            @default(now()) @map("last_seen_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     OwnerPushDelivery[]

  @@index([organizationId, active])
  @@index([userId, active])
  @@map("owner_push_devices")
}

model OwnerPushDelivery {
  id                String                     @id @default(cuid())
  organizationId    String                     @map("organization_id")
  alertId           String                     @map("alert_id")
  deviceId          String                     @map("device_id")
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @map("provider_message_id")
  errorMessage      String?                    @map("error_message")
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alert             OwnerAlert                 @relation(fields: [alertId], references: [id], onDelete: Cascade)
  device            OwnerPushDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([alertId, deviceId])
  @@index([organizationId, createdAt])
  @@map("owner_push_deliveries")
}

model DailyOwnerBriefing {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  stationScope   String       @map("station_scope")
  briefingDate   DateTime     @map("briefing_date") @db.Date
  calculatedAt   DateTime     @map("calculated_at")
  facts          Json
  narrative      Json
  narrativeMode  String       @map("narrative_mode")
  model          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, stationScope, briefingDate])
  @@index([organizationId, briefingDate])
  @@map("daily_owner_briefings")
}

model IntelligenceQuestion {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  requestKey     String       @map("request_key")
  userId         String       @map("user_id")
  stationId      String?      @map("station_id")
  question       String
  intent         String
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  facts          Json
  answer         Json
  answerMode     String       @map("answer_mode")
  model          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  station        Station?     @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("intelligence_questions")
}

model IntelligenceInvestigation {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  stationId      String       @map("station_id")
  userId         String       @map("user_id")
  requestKey     String       @map("request_key")
  findingIds     Json         @map("finding_ids")
  subject        String
  factSnapshot   Json         @map("fact_snapshot")
  snapshotHash   String       @map("snapshot_hash")
  result         Json
  narrativeMode  String       @map("narrative_mode")
  model          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station        Station      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestKey])
  @@index([organizationId, stationId, createdAt])
  @@index([userId, createdAt])
  @@map("intelligence_investigations")
}

model ApprovalRequest {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  stationId      String             @map("station_id")
  actionType     ApprovalActionType @map("action_type")
  status         ApprovalStatus     @default(PENDING)
  requestKey     String             @map("request_key")
  requestedById  String             @map("requested_by_id")
  requestedAt    DateTime           @default(now()) @map("requested_at")
  reason         String
  payload        Json
  evidence       Json
  decidedById    String?            @map("decided_by_id")
  decidedAt      DateTime?          @map("decided_at")
  decisionNote   String?            @map("decision_note")
  executedAt     DateTime?          @map("executed_at")
  executionType  String?            @map("execution_type")
  executionId    String?            @map("execution_id")
  version        Int                @default(1)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station        Station            @relation(fields: [stationId], references: [id], onDelete: Restrict)
  requestedBy    User               @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?              @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestKey])
  @@index([organizationId, status, requestedAt])
  @@index([stationId, status, requestedAt])
  @@map("approval_requests")
}

model Product {
  id                   String                  @id @default(cuid())
  organizationId       String                  @map("organization_id")
  name                 String
  code                 String
  hsnCode              String?                 @map("hsn_code")
  category             ProductCategory
  customCategoryId     String?                 @map("custom_category_id")
  unit                 UnitOfMeasure
  purchasePrice        Decimal                 @default(0) @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice         Decimal                 @default(0) @map("selling_price") @db.Decimal(12, 2)
  taxCategoryId        String?                 @map("tax_category_id")
  inventoryTracked     Boolean                 @default(true) @map("inventory_tracked")
  tankLinked           Boolean                 @default(false) @map("tank_linked")
  meterLinked          Boolean                 @default(false) @map("meter_linked")
  isService            Boolean                 @default(false) @map("is_service")
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customCategory       ProductCategorySetting? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  taxCategory          TaxCategory?            @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  tanks                Tank[]
  nozzles              Nozzle[]
  sales                Sale[]
  inventoryLedger      InventoryLedger[]
  receiptLines         ReceiptLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  sellingPriceHistory  ProductSellingPrice[]
  purchasePriceHistory ProductPurchasePrice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("products")
}

model ProductSellingPrice {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  price         Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, effectiveFrom])
  @@index([productId, effectiveFrom])
  @@map("product_selling_prices")
}

model ProductPurchasePrice {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  price         Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, effectiveFrom])
  @@index([productId, effectiveFrom])
  @@map("product_purchase_prices")
}

model ProductCategorySetting {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([organizationId, code])
  @@map("product_category_settings")
}

model TaxCategory {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  rate           Decimal      @db.Decimal(5, 2)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([organizationId, name])
  @@map("tax_categories")
}

model StationConfiguration {
  id            String      @id @default(cuid())
  stationId     String      @map("station_id")
  version       Int
  effectiveFrom DateTime    @default(now()) @map("effective_from")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  station       Station     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  tanks         Tank[]
  dispensers    Dispenser[]
  shifts        Shift[]

  @@unique([stationId, version])
  @@index([stationId, active])
  @@map("station_configurations")
}

model Tank {
  id               String               @id @default(cuid())
  configurationId  String               @map("configuration_id")
  productId        String               @map("product_id")
  code             String
  nominalCapacity  Decimal              @map("nominal_capacity") @db.Decimal(12, 3)
  workingCapacity  Decimal              @map("working_capacity") @db.Decimal(12, 3)
  openingStock     Decimal              @default(0) @map("opening_stock") @db.Decimal(12, 3)
  tankType         TankType             @map("tank_type")
  dipMethod        DipMethod            @map("dip_method")
  status           EquipmentStatus      @default(ACTIVE)
  configuration    StationConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  nozzleMappings   NozzleTank[]
  shiftReadings    ShiftTankReading[]
  sales            Sale[]
  inventoryLedger  InventoryLedger[]
  receiptLines     ReceiptLine[]
  physicalReadings TankReading[]
  densityReadings  TankDensityReading[]

  @@unique([configurationId, code])
  @@map("tanks")
}

model TankDensityReading {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  stationId      String       @map("station_id")
  tankId         String       @map("tank_id")
  density        Decimal      @db.Decimal(7, 3)
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  recordedById   String       @map("recorded_by_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station        Station      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  tank           Tank         @relation(fields: [tankId], references: [id], onDelete: Restrict)
  recordedBy     User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tankId, recordedAt])
  @@map("tank_density_readings")
}

model Shift {
  id                  String                    @id @default(cuid())
  stationId           String                    @map("station_id")
  configurationId     String                    @map("configuration_id")
  shiftNumber         Int                       @map("shift_number")
  managerId           String                    @map("manager_id")
  status              ShiftStatus               @default(DRAFT)
  openingCash         Decimal                   @map("opening_cash") @db.Decimal(12, 2)
  closingCash         Decimal?                  @map("closing_cash") @db.Decimal(12, 2)
  openedAt            DateTime                  @default(now()) @map("opened_at")
  closedAt            DateTime?                 @map("closed_at")
  notes               String?
  station             Station                   @relation(fields: [stationId], references: [id], onDelete: Restrict)
  configuration       StationConfiguration      @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  manager             User                      @relation("shift_manager", fields: [managerId], references: [id], onDelete: Restrict)
  users               ShiftUser[]
  tankReadings        ShiftTankReading[]
  nozzleReadings      ShiftNozzleReading[]
  nozzleAssignments   ShiftNozzleAssignment[]
  sales               Sale[]
  reconciliation      ShiftReconciliation?
  receiptTimingEvents ReceiptTimingAuditEvent[]

  @@unique([stationId, shiftNumber])
  @@index([stationId, status])
  @@map("shifts")
}

model ShiftUser {
  shiftId String @map("shift_id")
  userId  String @map("user_id")
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([shiftId, userId])
  @@map("shift_users")
}

model ShiftTankReading {
  id         String   @id @default(cuid())
  shiftId    String   @map("shift_id")
  tankId     String   @map("tank_id")
  openingDip Decimal  @map("opening_dip") @db.Decimal(12, 3)
  closingDip Decimal? @map("closing_dip") @db.Decimal(12, 3)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)

  @@unique([shiftId, tankId])
  @@map("shift_tank_readings")
}

model ShiftNozzleReading {
  id              String   @id @default(cuid())
  shiftId         String   @map("shift_id")
  nozzleId        String   @map("nozzle_id")
  openingMeter    Decimal  @map("opening_meter") @db.Decimal(14, 3)
  closingMeter    Decimal? @map("closing_meter") @db.Decimal(14, 3)
  testingQuantity Decimal  @default(0) @map("testing_quantity") @db.Decimal(12, 3)
  testingReturned Boolean  @default(true) @map("testing_returned")
  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  nozzle          Nozzle   @relation(fields: [nozzleId], references: [id], onDelete: Restrict)

  @@unique([shiftId, nozzleId])
  @@map("shift_nozzle_readings")
}

model ShiftNozzleAssignment {
  shiftId          String   @map("shift_id")
  nozzleId         String   @map("nozzle_id")
  userId           String   @map("user_id")
  collectionAmount Decimal? @map("collection_amount") @db.Decimal(14, 2)
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  nozzle           Nozzle   @relation(fields: [nozzleId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([shiftId, nozzleId])
  @@index([shiftId, userId])
  @@map("shift_nozzle_assignments")
}

model Dispenser {
  id              String               @id @default(cuid())
  configurationId String               @map("configuration_id")
  code            String
  location        String?
  status          EquipmentStatus      @default(ACTIVE)
  configuration   StationConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
