model Sale {
  id                  String               @id @default(cuid())
  organizationId      String               @map("organization_id")
  stationId           String               @map("station_id")
  shiftId             String               @map("shift_id")
  productId           String               @map("product_id")
  employeeId          String               @map("employee_id")
  tankId              String?              @map("tank_id")
  nozzleId            String?              @map("nozzle_id")
  kind                SaleKind
  paymentMethod       PaymentMethod        @map("payment_method")
  quantity            Decimal              @db.Decimal(14, 3)
  unitPrice           Decimal              @map("unit_price") @db.Decimal(12, 2)
  totalAmount         Decimal              @map("total_amount") @db.Decimal(14, 2)
  meterOpening        Decimal?             @map("meter_opening") @db.Decimal(14, 3)
  meterClosing        Decimal?             @map("meter_closing") @db.Decimal(14, 3)
  customerName        String?              @map("customer_name")
  vehicleNumber       String?              @map("vehicle_number")
  notes               String?
  occurredAt          DateTime             @default(now()) @map("occurred_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station             Station              @relation(fields: [stationId], references: [id], onDelete: Restrict)
  shift               Shift                @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  employee            User                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  tank                Tank?                @relation(fields: [tankId], references: [id], onDelete: Restrict)
  nozzle              Nozzle?              @relation(fields: [nozzleId], references: [id], onDelete: Restrict)
  inventoryLedger     InventoryLedger?
  customerId          String?              @map("customer_id")
  vehicleId           String?              @map("vehicle_id")
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
