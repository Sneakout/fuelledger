model User {
  id                         String                      @id @default(cuid())
  organizationId             String                      @map("organization_id")
  email                      String                      @unique
  name                       String
  passwordHash               String                      @map("password_hash")
  loginEnabled               Boolean                     @default(true) @map("login_enabled")
  mustChangePassword         Boolean                     @default(false) @map("must_change_password")
  role                       UserRole                    @default(STAFF)
  active                     Boolean                     @default(true)
  lastLoginAt                DateTime?                   @map("last_login_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shiftsManaged              Shift[]                     @relation("shift_manager")
  shiftAssignments           ShiftUser[]
  nozzleAssignments          ShiftNozzleAssignment[]
  defaultNozzleAssignments   NozzleAttendantAssignment[]
  sales                      Sale[]
  inventoryEntries           InventoryLedger[]
  purchaseReceipts           PurchaseReceipt[]
  tankReadings               TankReading[]
  densityReadings            TankDensityReading[]
  reconciliations            ShiftReconciliation[]       @relation("reconciled_by")
  customerReceipts           CustomerReceipt[]
  customerLedger             CustomerLedgerEntry[]
  purchaseInvoices           PurchaseInvoice[]
  purchaseInvoiceCorrections PurchaseInvoiceCorrection[]
  supplierPayments           SupplierPayment[]
  expenses                   Expense[]
  journals                   Journal[]
  stationAccess              UserStationAccess[]
  sessions                   UserSession[]
  receiptTimingEvents        ReceiptTimingAuditEvent[]
  acknowledgedAlerts         OwnerAlert[]                @relation("alert_acknowledger")
  pushDevices                OwnerPushDevice[]
  intelligenceQuestions      IntelligenceQuestion[]
  intelligenceInvestigations IntelligenceInvestigation[]
  approvalRequestsMade       ApprovalRequest[]           @relation("ApprovalRequester")
  approvalDecisions          ApprovalRequest[]           @relation("ApprovalDecider")

  @@index([organizationId])
  @@map("users")
}

model UserSession {
  id         String    @id
  userId     String    @map("user_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuthThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("auth_throttles")
}

model UserStationAccess {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  stationId String   @map("station_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([userId, stationId])
  @@index([stationId])
  @@map("user_station_access")
}

model DemoSession {
  id        String   @id @default(cuid())
  contact   String
  kind      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("demo_sessions")
}

model DemoAccessClaim {
  contact     String   @id
  kind        String
  firstUsedAt DateTime @default(now()) @map("first_used_at")

  @@map("demo_access_claims")
}
