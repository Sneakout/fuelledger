NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fuelledger:fuelledger@localhost:5432/fuelledger?schema=public
# Optional locally. In production, use Neon's unpooled connection URL so migrations
# do not run through PgBouncer. The deploy script falls back to DATABASE_URL.
DIRECT_URL=postgresql://fuelledger:fuelledger@localhost:5432/fuelledger?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Comma-separated browser origins, e.g. https://fuel.mindvector.tech,https://fuelledger.mindvector.tech
CORS_ADDITIONAL_ORIGINS=
PLATFORM_ADMIN_EMAILS=owner@example.com
VITE_API_URL=http://localhost:4000/api
GOOGLE_CLIENT_ID=973093800218-5m2qk76rgnj0ka90iqvu7712kmir6d0j.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=973093800218-5m2qk76rgnj0ka90iqvu7712kmir6d0j.apps.googleusercontent.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=fuelledger_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
# Apple requires a Services ID plus server-side Team ID, Key ID, and private key.
VITE_APPLE_CLIENT_ID=
OPENAI_API_KEY=
NERVE_EXPLANATION_PROVIDER=static
NERVE_OPENAI_MODEL=
NERVE_MODEL_TIMEOUT_MS=7000
OPENAI_BRIEFING_MODEL=gpt-5.4-mini
INTELLIGENCE_ASK_MONTHLY_LIMIT=25
INTELLIGENCE_INVESTIGATION_MONTHLY_LIMIT=50
OWNER_ASSISTANT_RELEASE_STAGE=OFF
OWNER_ASSISTANT_ROLLOUT_PERCENT=0
OWNER_ASSISTANT_ROLLBACK=false

# Local Nerve shadow testing only. Keep disabled unless actively testing one
# non-production organization and station. Generate a secret with:
# openssl rand -hex 32
NERVE_LOCAL_SHADOW_ENABLED=false
NERVE_LOCAL_KEY_ID=local-fuelnerve
NERVE_LOCAL_SHARED_SECRET=
NERVE_LOCAL_ORGANIZATION_ID=
NERVE_LOCAL_STATION_ID=
NERVE_LOCAL_REPORT_PATH=./nerve-agent-platform/.local-shadow/latest.json
