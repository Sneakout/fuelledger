NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fuelledger:fuelledger@localhost:5432/fuelledger?schema=public
# Optional locally. In production, use Neon's unpooled connection URL so migrations
# do not run through PgBouncer. The deploy script falls back to DATABASE_URL.
DIRECT_URL=postgresql://fuelledger:fuelledger@localhost:5432/fuelledger?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
PLATFORM_ADMIN_EMAILS=owner@example.com
VITE_API_URL=http://localhost:4000/api
GOOGLE_CLIENT_ID=973093800218-5m2qk76rgnj0ka90iqvu7712kmir6d0j.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=973093800218-5m2qk76rgnj0ka90iqvu7712kmir6d0j.apps.googleusercontent.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=fuelledger_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
# Apple requires a Services ID plus server-side Team ID, Key ID, and private key.
VITE_APPLE_CLIENT_ID=
