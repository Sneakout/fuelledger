{
  "name": "fuelledger",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "dev": "corepack pnpm --parallel --filter @fuelledger/api --filter @fuelledger/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/demo-seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^22.15.0",
    "bcryptjs": "3.0.3",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
